        // upgraders, and its value is banked at the collector.
        (start: (-33.0, -28.0), end: (11.0, -28.0), collector: (14.0, -28.0)),
        (start: (-33.0, -14.0), end: (11.0, -14.0), collector: (14.0, -14.0)),
